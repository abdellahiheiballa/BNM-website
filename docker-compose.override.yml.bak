version: '3.8'
services:
  frontend:
    image: node:22-bullseye
    working_dir: /app
    ports:
      - "5174:5173"
    environment:
      - CHOKIDAR_USEPOLLING=true
    volumes:
      - ./artifacts/bnm-site:/app:cached
      - /app/node_modules
    command: bash -lc "corepack enable && pnpm install --no-frozen-lockfile && pnpm dev --host 0.0.0.0"
    depends_on:
      - backend
    restart: unless-stopped
